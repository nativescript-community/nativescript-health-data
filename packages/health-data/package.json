{
    "name": "@nativescript-community/health-data",
    "version": "2.0.0",
    "description": "Health Data plugin for Nativescript, using Google Fit and Apple HealthKit.",
    "main": "./index",
    "sideEffects": false,
    "typings": "./index.d.ts",
    "scripts": {
        "build": "npm run tsc && npm run readme",
        "build.watch": "npm run tsc -- -w",
        "build.all": "npm run build",
        "readme": "readme generate -c ../../tools/readme/blueprint.json",
        "tsc": "cpy '**/*.d.ts' '../../packages/health-data' --parents --cwd=../../src/health-data && tsc  --build",
        "clean": "bin/rimraf ./*.d.ts ./*.js ./*.js.map ./*.tsbuildinfo ./*.mjs ./*.mjs.map ./angular ./svelte ./vue* ./react"
    },
    "nativescript": {
        "platforms": {
            "android": "6.0.0",
            "ios": "6.0.0"
        }
    },
    "keywords": [
        "NativeScript",
        "JavaScript",
        "Android",
        "iOS",
        "Health",
        "HealthKit",
        "Google Fit"
    ],
    "author": {
        "name": "Eddy Verbruggen",
        "email": "eddyverbruggen@gmail.com"
    },
    "contributors": [
        {
            "name": "Filipe Mendes",
            "email": "filipemendes1994@gmail.com"
        },
        {
            "name": "Daniel Leal",
            "url": "https://github.com/danielgek"
        }
    ],
    "bugs": {
        "url": "https://github.com/nativescript-community/health-data/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nativescript-community/health-data"
    },
    "license": "Apache-2.0",
    "readmeFilename": "README.md",
    "dependencies": {}
}
